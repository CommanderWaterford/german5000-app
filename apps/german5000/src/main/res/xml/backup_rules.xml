<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower (spec §13.2): exclude all app-managed progress, entitlement caches,
  preferences and static content from Auto Backup. Learners use "Export progress" instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
